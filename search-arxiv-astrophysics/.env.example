# Copy this file to .env and fill in missing values.

# Zotero credentials
ZOTERO_USER_ID=
ZOTERO_API_KEY=

# arXiv query settings
ARXIV_KEYWORDS_FILE=assets/keywords.txt
# Deprecated and ignored (retrieval is category-only):
# ARXIV_MATCH=any
# Optional override. Comma-separated categories:
# ARXIV_CATEGORIES=astro-ph.CO,astro-ph.EP,astro-ph.GA,astro-ph.HE,astro-ph.IM,astro-ph.SR,gr-qc

# Semantic ranking settings
OPENAI_API_KEY=
SEMANTIC_MODE=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
SEMANTIC_WEIGHT=0.90
KEYWORD_WEIGHT=0.10
SEMANTIC_CACHE_PATH=assets/semantic_cache.sqlite

# Optional new-paper threshold selection. Set either or both; when both are set,
# a paper must pass both thresholds. Overall means the weighted final score.
# NEW_SEMANTIC_THRESHOLD=0.65
# NEW_OVERALL_THRESHOLD=0.65

# Email alert settings (fill these)
ALERT_EMAIL_TO=you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_TO=
SMTP_USE_SSL=false

# Optional
# ALERT_PREVIEW_ONLY=true
# If TLS cert trust is broken on this machine, run script with --insecure-tls
